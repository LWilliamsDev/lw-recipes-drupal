<?php

use Drupal\block\Entity\Block;

/**
 * Implements hook_theme_suggestions_HOOK_alter() for taxonomy term templates.
 */

function lw_recipes_theme_suggestions_taxonomy_term_alter(array &$suggestions, array $vars) {
  
  /** @var \Drupal\taxonomy\TermInterface $term */
  $term = $vars['elements']['#taxonomy_term'];
  $view_mode = $vars['elements']['#view_mode'];
  $bundle = $term->bundle();

  // Add suggestion: taxonomy-term--bundle--view-mode.html.twig
  $suggestions[] = 'taxonomy_term__' . $bundle . '__' . $view_mode;

}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for fieldsets.
 */
function lw_recipes_theme_suggestions_fieldset_alter(array &$suggestions, array $vars) {

  // If we are currently rendering an element inside a View
  if (!empty($vars['element']['#context']['#view_id'])) {
    $view_id = $vars['element']['#context']['#view_id'];
    $sanitized_view_id = str_replace('-', '_', $view_id);
    
    // Suggestion 1: fieldset--view-view-name.html.twig
    // (Targets ALL fieldsets inside this specific view)
    $suggestions[] = 'fieldset__' . $sanitized_view_id;
    
    // Suggestion 2: fieldset--view-view-name--field-name.html.twig
    // (Targets a specific filter fieldset inside this specific view)
    if (!empty($vars['element']['#name'])) {
      $field_name = str_replace('-', '_', $vars['element']['#name']);
      $suggestions[] = 'fieldset__' . $sanitized_view_id . '__' . $field_name;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for pager templates.
 */
function lw_recipes_preprocess_pager(&$vars) {
  // If a pager exists in the active build render context
  if (!empty($vars['pager'])) {
    /** @var \Drupal\Core\Pager\Pager $pager */
    // Pull the underlying Drupal Pager object directly
    $pager = \Drupal::service('pager.manager')->getPager();
    
    if ($pager) {
      // Get total pages count (1-indexed for easy printing)
      $vars['total_pages_count'] = $pager->getTotalPages();
    }
  }
}


/**
 * Implements hook_preprocess_block().
 *
 * Add theme suggestion for menu based on its region, as the main menu in the header has
 * some changes that we don't want when it is displayed elsewhere.
 */
function lw_recipes_preprocess_block(&$vars) {
  // Check if this block contains a menu render array
  if (isset($vars['content']['#menu_name'])) {
    
    // Make sure we have a valid block ID to inspect
    if (!empty($vars['elements']['#id'])) {
      
      // Load the block configuration entity
      $block = Block::load($vars['elements']['#id']);
      
      if ($block) {
        // Extract the region this block is placed in (e.g., 'header', 'sidebar_first')
        $region = $block->getRegion();
        
        // Append the region to the menu's internal #theme variable!
        if (isset($vars['content']['#theme']) && is_string($vars['content']['#theme'])) {
          // Example: 'menu__main' becomes 'menu__main__header'
          $vars['content']['#theme'] .= '__' . $region;
        }
      }
    }
  }
}