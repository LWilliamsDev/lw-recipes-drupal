{# Declare variables #}
{% set hero_image = content.hero_image %}
{% set hero_subtitle = content.hero_subtitle|render %}
{% set hero_title = content.hero_title %}
{% set hero_cta = content.hero_cta|render %}
{% set latest_recipes_title = content.latest_recipes_title|render %}
{% set latest_recipes = node.getLatestRecipes() %}
{% set taxonomy = content.taxonomy|render %}
{% set taxonomy_section_title = content.taxonomy_section_title|render %}
{% set taxonomy_section = node.getTaxonomyTerms() %}

<section class="hero grid h-[358px] md:h-[717px]">
	<div class="hero row-span-full col-span-full relative">
		<div class="home__hero">
			{{ hero_image }}
		</div>
		{#<img src="assets/img/home/hero-image.jpg" alt="Hero Image" class="col-span-full row-span-full absolute top-0 left-0 w-full h-full object-cover" />#}
		<div class="bg-(--color-tan) block w-full h-full opacity-80 absolute left-0 top-0"></div>
	</div>
	<div class="row-span-full col-span-full relative z-2 text-center self-center">
		<h1 class="font-roboto-condensed text-4xl md:text-6xl uppercase text-(--color-green) mb-[10px] md:mb-[20px]">{{ hero_title }}</h1>
		{% if hero_subtitle %}
			<div class="text-color(--color-dark-green) text-sm md:text-2xl mb-[15px] md:mb-[20px]">{{ hero_subtitle }}</div>
		{% endif %}

		{% if hero_cta %}
		<div class="hero-image__cta">{{ hero_cta }}</div>
		{% endif %}
	</div>
</section>

{% if latest_recipes %}
	<section class="px-4 py-8 md:px-12 md:py-12">
		<h2 class="font-roboto-condensed text-5xl color-green text-(--color-green) mb-8 uppercase">
			{% if latest_recipes_title %} 
				{{ latest_recipes_title }}
			{% else %}
				{{ 'Latest Recipes'|t }}
			{% endif %}
		</h2>
		{{ latest_recipes }}
	</section>
{% endif %}

{% if taxonomy_section %}
	<section class="px-4 pt-8 md:px-12 md:pt-12">
		<h2 class="font-roboto-condensed text-5xl color-green text-(--color-green) mb-8 uppercase">
			{% if taxonomy_section_title %}
				{{ taxonomy_section_title }}
			{% else %}
				{{ 'Browse by'|t }} {{- taxonomy -}}
			{% endif %}
		</h2>
			{{ taxonomy_section }}
	</section>
{% endif %}