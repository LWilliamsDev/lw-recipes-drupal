{% set image = content.hero_image %}
{% set excerpt = content.excerpt %}
{% set links = node.getRecipeTermLinks('diet') %}

<div class="card mb-8 recipe__latest">
	<a href="{{ url }}">
        {{ image }}
    </a>
	<h3 class="text-2xl font-medium text-(--color-brown)"><a href="{{ url }}">{{ node.label }}</a></h3>
		<div class="text-(--color-dark-green)">{{ excerpt }}</div>
			<ul class="categories mt-5 flex flex-wrap gap-[10px]">
                {% if links %}
				{% for link in links %}
					<li>
                   	 <a href="{{ link.url }}" class="button p-[10px] inline-block rounded-sm text-(--color-white) font-medium">{{ link.text }}</a>
                	</li>
				{% endfor %}
				{% endif %}
			</ul>
</div>