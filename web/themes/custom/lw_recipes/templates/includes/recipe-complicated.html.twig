{# Complex/Complicated recipe #}

<div class="mt-[30px] mb-[30px] text-(--color-dark-green) recipe__complex">
	<div class="mb-[30px]">
		<h2 class="text-3xl font-roboto-condensed uppercase text-(--color-green)">{{'Ingredients'|t}}</h2>
		<div class="md:grid gap-x-5 md:grid-cols-[1fr_1fr] md:gap-y-5">
				{{ ingredients_col1 }}
				{{ ingredients_col2 }}				
		</div>
	</div>
	<div>
		<h2 class="text-3xl font-roboto-condensed uppercase text-(--color-green)">{{'Instructions'|t}}</h2>
			{{ instructions }}	
	</div>
</div>