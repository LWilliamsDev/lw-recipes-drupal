{# Simple recipe #}

<div class="grid grid-cols-[1fr] mt-[30px] mb-[30px] md:grid-cols-[2fr_1fr] md:gap-x-5 text-(--color-dark-green) recipe__simple">
	<div class="order-2 md:order-none">
		<h2 class="text-3xl font-roboto-condensed uppercase text-(--color-green)">{{'Instructions'|t}}</h2>
			{{ instructions }}
	</div>
	<div class="mb-[30px] md:mb-[0px] order-1 md:order-none">
		<h2 class="text-3xl font-roboto-condensed uppercase text-(--color-green)">{{'Ingredients'|t}}</h2>
			{{ ingredients_col1 }}
	</div>
</div>