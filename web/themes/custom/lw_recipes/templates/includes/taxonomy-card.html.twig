{# Card for the Taxonomy Section on the homepage #}

<div class="card mb-8">
	<h3>
		<a href="{{ url }}" class="grid block">
			<div class="recipe-taxonomy__image col-start-1 row-start-1">
            	{{ image }}
			</div>
			<div class="bg-(--color-tan) col-start-1 row-start-1 opacity-90 self-end p-4">
				<span class="text-2xl font-medium text-(--color-brown) hover:text-(--color-mid-green)">{{ name }}</span>
			</div>
		</a>
	</h3>
</div>