{#
/**
 * @file
 * Default theme implementation of a views exposed form.
 *
 * Available variables:
 * - form: A render element representing the form.
 *
 * @see template_preprocess_views_exposed_form()
 *
 * @ingroup themeable
 */
#}
{% if q is not empty %}
  {#
    This ensures that, if clean URLs are off, the 'q' is added first,
    as a hidden form element, so that it shows up first in the POST URL.
  #}
{{ q }}
{% endif %}

<div class="form mt-8 md:mt-12 row-1 md:col-span-full grid grid-cols-[1fr_40px] gap-x-2">
  {{ form.search }}
  {{ form.actions }}
  
</div>
<div class="refiners mt-8 mb-8 md:mb-0 md:col-1 md:row-3 md:mt-12">
  <div class="refiner-fieldset mb-4">
    {{ form.course }}
  </div>
  <div class="refiner-fieldset mb-4">
    {{ form.diet }}
  </div>
  <div class="refiner-fieldset">
    {{ form.allergen }}
  </div>
</div>
{{ form|without('search', 'diet', 'course', 'allergen', 'actions') }}
